# System
# See: https://github.com/artemsen/swaykbdd
exec swaykbdd
# See: https://github.com/nwg-piotr/autotiling
exec_always autotiling -l 3 -sr 1.618
exec swayidle -w \
        timeout 180 'brightnessctl -s && brightnessctl set 15%' \
        resume 'brightnessctl -r' \
        timeout 300 '$lock' \
        timeout 600 'swaymsg "output * power off"' \
                resume 'swaymsg "output * power on"' \
        before-sleep '$lock'
exec sway-audio-idle-inhibit
exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1

# Programs
exec throne --appdata -tray
exec qbittorrent
exec Telegram -autostart
exec nm-applet
# exec /usr/bin/discord
exec /usr/bin/steam -silent
