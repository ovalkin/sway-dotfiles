# Pop-Up 
for_window [app_id="firefox" title="Картинка в картинке"] {
    floating enable
    resize set 600
    sticky enable
} 
for_window [app_id="org.telegram.desktop" title="TelegramDesktop"] {
    floating enable
    resize set 600
    sticky enable
}
for_window [app_id="nemo" title=".*Properties.*"] {
    floating enable
}
for_window [window_role="dialog"] {
    floating enable
}



# Throne
for_window [app_id="Throne"] {
    floating enable
    resize set 810 610
    sticky enable
}
# pulseaudio
for_window [app_id="org.pulseaudio.pavucontrol"] {
    floating enable
    resize set  770 550
    sticky enable
}

for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen