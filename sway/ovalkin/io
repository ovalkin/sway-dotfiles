#
# INPUT
# RUN swaymsg -t get_inputs

input type:touchpad {
    tap enable
    dwt enabled
    middle_emulation enabled
    natural_scroll enabled
    accel_profile adaptive
    pointer_accel 0
    drag_lock disabled
}
input type:pointer {
    accel_profile flat
    pointer_accel 0.1
}
input type:keyboard {
    repeat_delay 220
    repeat_rate 30
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
    xkb_numlock enabled
}
input type:touch {   }
input type:tablet_tool {   }
input type:tablet_pad {   }
input type:switch {   }

#
# OUTPUT
# RUN swaymsg -t get_outputs

# Monitors
output HDMI-A-1 pos 0 0 res 1920x1080@99.999Hz scale 1
# output HDMI-A-1 pos 0 0 res 1280x720@99.999Hz scale 1
output eDP-1 pos -1920 0 res 1920x1200@60.003Hz scale 1

workspace 1 output HDMI-A-1
workspace 9 output eDP-1