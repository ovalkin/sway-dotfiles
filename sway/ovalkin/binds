# Basic
bindsym --to-code --no-repeat {
    $mod+Return exec $term
    $mod+q kill
    $mod+d exec $menu
    $mod+e exec $exploer
    $mod+Shift+c reload
    $mod+Shift+e exec swaynag -t warning -m 'Вы действительно хотите выйти?' -B 'Да' 'swaymsg exit'
    $mod+l exec $lock
}
floating_modifier $mod normal

# Moving and resize around
bindsym --to-code {
    $mod+Left focus left
    $mod+Down focus down
    $mod+Up focus up
    $mod+Right focus right

    $mod+Shift+Left resize shrink width 10 px
    $mod+Shift+Down resize grow height 10 px
    $mod+Shift+Up resize shrink height 10 px
    $mod+Shift+Right resize grow width 10 px
}

# Workspaces
workspace_auto_back_and_forth yes
bindsym --to-code {
    $mod+Tab workspace next
    $mod+SHift+Tab workspace prev    
    # Switch to workspace
    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9
    $mod+a workspace A
    
    # Move focused container to workspace
    $mod+Shift+1 move container to workspace number 1
    $mod+Shift+2 move container to workspace number 2
    $mod+Shift+3 move container to workspace number 3
    $mod+Shift+4 move container to workspace number 4
    $mod+Shift+5 move container to workspace number 5
    $mod+Shift+6 move container to workspace number 6
    $mod+Shift+7 move container to workspace number 7
    $mod+Shift+8 move container to workspace number 8
    $mod+Shift+9 move container to workspace number 9
    $mod+Shift+a move container to workspace A
}

# Layout stuff
bindsym --no-repeat --to-code {
    # Switch the current container between different layout styles
    $mod+w layout tabbed
    $mod+s layout toggle split
    
    # Make the current focus fullscreen
    $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    $mod+space floating toggle
    $mod+r sticky toggle
}

# Utilities
bindsym --locked {
    # Special keys to adjust volume via PulseAudio
    XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
    # Special keys to adjust brightness via brightnessctl
    XF86MonBrightnessDown exec brightnessctl set 5%-
    XF86MonBrightnessUp exec brightnessctl set 5%+
    # Special keys to player via playerctl
    XF86AudioPlay exec playerctl play-pause
    XF86AudioPrev exec playerctl previous
    XF86AudioNext exec playerctl next


}

# Screenshots
bindsym --no-repeat --to-code {
    $mod+Shift+s exec grim -g "$(slurp)" - | swappy -f -
    Print exec grim - | swappy -f -
}
